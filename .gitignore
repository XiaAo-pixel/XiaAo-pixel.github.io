# Jekyll 本地构建产物与临时文件
_site/

# split-notes.ps1 的运行记录（生成出来的 ch<章号>-<节号>.md 要提交，这个不用）
notes/*/.sections.json

# 本地预览用的模拟页面与截图
_preview/

# 主页助手（可视化编辑器）本地运行文件
editor/.backups/
editor/node_modules/
editor/.test-site/
editor/.test-tools/
editor/.shots/
editor/.edge-profile/
editor/.server.log
editor/.server.pid
.qoder-credits/

/desktop/release/
/desktop/.cache/
/node_modules/

# 把便携版 EXE 放在工程根目录时，不要让「一键发布」把它提交进仓库
/HomepageStudio-*-portable.exe
